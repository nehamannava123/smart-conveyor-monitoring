# =====================================================================
# HillGuard Environment Configuration Template
# =====================================================================

# Server network port
PORT=4000
NODE_ENV=development

# Security: JWT secret key (REQUIRED in production, minimum 32 random characters)
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRY=8h

# Initial Administrator Provisioning (REQUIRED in production)
# In production, initial admin cannot use default passwords. Must be >= 8 characters.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# CORS Origin Allowlist (comma-separated origins allowed to make API requests)
# Defaults to same-origin in production if left blank
CORS_ORIGIN=http://localhost:4000

# Sensor Simulation Configuration
# Interval in milliseconds between telemetry ticks
SIM_TICK_MS=2000

# Automated Emergency Stop (Software Simulation)
# Master switch for automated simulated stop on consecutive critical readings.
# HillGuard is an advisory system and does NOT replace certified hardware safety PLCs.
AUTO_STOP_ENABLED=false
AUTO_STOP_THRESHOLD_TICKS=3

# Alert Management & Debouncing
# Number of ticks before repeating a similar unacknowledged alert for persistent faults
ALERT_REPEAT_TICKS=6
# Score jump required to immediately break suppression
ALERT_SCORE_INCREASE=12

# Video Inspection (Computer Vision via FFmpeg)
VIDEO_FRAME_RATE=2
VIDEO_MAX_FRAMES=40

# Web Push Notification VAPID Keys
# Generate stable keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
